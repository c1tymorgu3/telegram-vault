API_ID=12345678
API_HASH=your_api_hash_here
DATABASE_URL=postgresql+asyncpg://user:password@localhost/telegramlogs
PHONE_NUMBER=+1234567890
DASHBOARD_PASSWORD=your_secure_password
SESSION_SECRET=replace_with_a_secure_random_string
HCAPTCHA_SITE_KEY=your_hcaptcha_site_key_optional
HCAPTCHA_SECRET_KEY=your_hcaptcha_secret_key_optional

# --- Account identity -------------------------------------------------------
# Set ACCOUNT, then API_ID_<ACCOUNT> overrides API_ID for this deployment.
# Never run two accounts on one api_id: shared api_id + shared IP is how
# Telegram links accounts, and one flag then takes out the whole cluster.
# ACCOUNT=alt1
# API_ID_ALT1=12345678
# API_HASH_ALT1=your_api_hash_here

# Session file name (one per account). Defaults to userbot_session.
SESSION_NAME=userbot_session

# Real client identity. Leave as a real device/version pair; "Telethon" is a
# fingerprint.
DEVICE_MODEL=Samsung SM-A546B
SYSTEM_VERSION=SDK 33
APP_VERSION=10.9.1 (4665)
LANG_CODE=en
LANG_PACK=en

# One account, one egress address. socks5://user:pass@host:port or
# mtproxy://secret@host:port
# PROXY=socks5://user:pass@host:1080

# Opt-in only. Setting this to 1 lets a run request a login code; leave it 0
# and log in from a normal client instead.
ALLOW_NEW_LOGIN=0
